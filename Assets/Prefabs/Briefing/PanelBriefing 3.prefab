  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Has llegado al coraz\xF3n del planeta.\nLas islas flotantes son tu \xFAltimo
    desaf\xEDo.\n\nEncuentra el cristal azul\nColoca los 3 cristales en los estantes:\n  
    Cristal Amarillo\n   Cristal Rojo\n   Cristal Azul\n\nCONTROLES ESPECIALES:\n  
    1, 2, 3 \u2192 Cambiar gravedad\n\nUna vez coloques los 3 cristales\n\xA1salvar\xE1s
    el n\xFAcleo y ganar\xE1s!\n\n\xA1\xDALTIMO AVISO: cuida tu ox\xEDgeno!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b7ac08706c4720d4491f5c11341892f0, type: 2}
